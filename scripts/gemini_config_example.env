# Example configuration for using Gemini with the knowledge graph script

# Google API Key - Get this from Google AI Studio (https://ai.google.dev/)
GOOGLE_API_KEY=your_google_api_key_here

# LLM Configuration
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2000

# Embedding Configuration  
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=models/text-embedding-004

# Neo4j Configuration
GRAPH_DB_URL=neo4j://localhost:7687
GRAPH_DB_USER=neo4j
GRAPH_DB_PASSWORD=your_password_here
