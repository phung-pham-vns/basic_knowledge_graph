# Multi-Provider Configuration Examples for Knowledge Graph Script

# =============================================================================
# OPENAI CONFIGURATION
# =============================================================================
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=your_openai_api_key_here
# LLM_TEMPERATURE=0.0
# LLM_MAX_TOKENS=16384
# 
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536

# =============================================================================
# GEMINI CONFIGURATION
# =============================================================================
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-1.5-flash
# LLM_API_KEY=your_google_api_key_here
# LLM_TEMPERATURE=0.0
# LLM_MAX_TOKENS=2000
# 
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_MODEL=models/text-embedding-004

# =============================================================================
# OLLAMA CONFIGURATION (Local)
# =============================================================================
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1
# LLM_ENDPOINT=http://localhost:11434
# LLM_TEMPERATURE=0.0
# LLM_MAX_TOKENS=4096
# 
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=nomic-embed-text

# =============================================================================
# HUGGINGFACE/SELF-HOSTED CONFIGURATION
# =============================================================================
# LLM_PROVIDER=huggingface
# LLM_MODEL=microsoft/DialoGPT-medium
# LLM_TEMPERATURE=0.0
# LLM_MAX_TOKENS=2000
# 
# EMBEDDING_PROVIDER=huggingface
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# =============================================================================
# NEO4J CONFIGURATION (Common for all providers)
# =============================================================================
GRAPH_DB_URL=neo4j://localhost:7687
GRAPH_DB_USER=neo4j
GRAPH_DB_PASSWORD=your_password_here

# =============================================================================
# ACTIVE CONFIGURATION (Uncomment one set above and set these)
# =============================================================================
# Copy the desired configuration from above and uncomment it
# Default to OpenAI for this example
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your_openai_api_key_here
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=16384

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

